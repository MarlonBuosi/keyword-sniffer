# systemd unit for the WhatsApp keyword monitor. Installed by deploy/setup.sh
# to /etc/systemd/system/wa-monitor.service.
#
#   systemctl status wa-monitor
#   journalctl -u wa-monitor -f -o cat | /opt/wa-monitor/node_modules/.bin/pino-pretty

[Unit]
Description=WhatsApp keyword monitor
Wants=network-online.target
After=network-online.target
# Don't restart forever if something is badly broken (e.g. a bad build).
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=simple
User=wa
Group=wa
WorkingDirectory=/opt/wa-monitor
Environment=NODE_ENV=production
# LOG_LEVEL, PAIR_PHONE (optional)
EnvironmentFile=-/etc/wa-monitor.env
ExecStart=/usr/bin/node dist/index.js

# Exit 1 (reconnects exhausted) or a crash -> restart. Exit 2 = the session is
# logged out / rejected: stay down until re-paired (see src/connection.ts).
Restart=on-failure
RestartSec=5
RestartPreventExitStatus=2

MemoryMax=400M

# Hardening: the app may only write its session and config.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/opt/wa-monitor/auth_state -/opt/wa-monitor/config.json
UMask=0077

[Install]
WantedBy=multi-user.target
